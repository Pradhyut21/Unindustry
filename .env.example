# Environment variables for ProductTruth
# Copy to .env and fill in real values

# --- Database ---
POSTGRES_USER=producttruth
POSTGRES_PASSWORD=producttruth
POSTGRES_DB=producttruth

# For Supabase hosted (override DATABASE_URL entirely):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
CONFIDENCE_THRESHOLD=0.7
ENVIRONMENT=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
