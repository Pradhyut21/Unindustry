# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=producttruth
POSTGRES_PASSWORD=producttruth
POSTGRES_DB=producttruth

# For local dev (outside Docker) — uses localhost:5432
# docker-compose overrides this with the service name "postgres"
DATABASE_URL=postgresql+asyncpg://producttruth:producttruth@localhost:5432/producttruth

# ── AI Provider ───────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ── Pipeline ──────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Frontend (for local dev outside Docker) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
